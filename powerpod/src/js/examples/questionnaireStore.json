                  "questions": [
                    {
                        "id": "ca95a1c0-1073-f011-bec2-000d3a0c38d2",
                        "complete": true,
                        "name": "310",
                        "label": "<div class=\"ck-content\" data-wrapper=\"true\" dir=\"ltr\" style=\"--ck-image-style-spacing: 1.5em; --ck-inline-image-style-spacing: calc(var(--ck-image-style-spacing) / 2); font-family: Segoe UI; font-size: 11pt;\"><p style=\"margin: 0;\"><span style=\"font-family:&quot;BC Sans&quot;;font-size:11.0pt;\"><span style=\"line-height:107%;\" lang=\"EN-US\"><strong>310. Do you manage livestock watering in a way that protects water and habitat?&nbsp;</strong></span></span></p></div>",
                        "order": 95,
                        "questionType": 100000001,
                        "textAboveQuestion": null,
                        "textBelowQuestion": "<div class=\"ck-content\" data-wrapper=\"true\" dir=\"ltr\" style=\"--ck-image-style-spacing: 1.5em; --ck-inline-image-style-spacing: calc(var(--ck-image-style-spacing) / 2); font-family: Segoe UI; font-size: 11pt;\"><div style=\"font-family:Segoe UI;font-size:11pt;\"><p style=\"line-height: normal; margin: 0cm 0cm 0cm 0;\">Recommended practices include:</p><ul style=\"list-style-position: inside;\"><li>Keeping water troughs clean and placed properly so that manure or runoff doesn’t flow into nearby streams, wells, or onto neighboring land.</li><li>Limit livestock access to nearby streams</li><li>Make sure animals don’t damage nearby streambanks or habitat</li><li>Use watering systems that don’t rely on direct access to streams</li></ul></div><p style=\"margin: 0;\">&nbsp;</p><p style=\"margin: 0;\"><u>Risk ratings for this question:</u></p><p style=\"margin: 0;\">&nbsp;</p><table class=\"table\" style=\"border-collapse:collapse;border-color:inherit;border-style:none;display:block;width:inherit;\" display=\"block\" width=\"inherit\" cellpadding=\"0\" cellspacing=\"0\" border=\"inherit\"><tbody><tr><td style=\"background-color:#00B050;border-color:windowtext;padding:0px 7px;vertical-align:top;width:151px;\" aria-label=\"Table cell\" width=\"151\"><p style=\"line-height: normal; margin: 0cm;\"><span style=\"color:black;font-family:&quot;BC Sans&quot;;font-size:12pt;\"><b><span lang=\"EN-US\">Risk Rating 1</span></b></span></p></td><td style=\"background-color:yellow;border-bottom-style:solid;border-color:windowtext;border-left-style:none;border-right-style:solid;border-top-style:solid;padding:0px 7px;vertical-align:top;width:151px;\" aria-label=\"Table cell\" width=\"151\"><p style=\"line-height: normal; margin: 0cm;\"><span style=\"color:black;font-family:&quot;BC Sans&quot;;font-size:12pt;\"><b><span lang=\"EN-US\">Risk Rating 2</span></b></span></p></td><td style=\"background-color:#FFC000;border-bottom-style:solid;border-color:windowtext;border-left-style:none;border-right-style:solid;border-top-style:solid;padding:0px 7px;vertical-align:top;width:151px;\" aria-label=\"Table cell\" width=\"151\"><p style=\"line-height: normal; margin: 0cm;\"><span style=\"color:black;font-family:&quot;BC Sans&quot;;font-size:12pt;\"><b><span lang=\"EN-US\">Risk Rating 3</span></b></span></p></td><td style=\"background-color:#EE0000;border-bottom-style:solid;border-color:windowtext;border-left-style:none;border-right-style:solid;border-top-style:solid;padding:0px 7px;vertical-align:top;width:151px;\" aria-label=\"Table cell\" width=\"151\"><p style=\"line-height: normal; margin: 0cm;\"><span style=\"color:black;font-family:&quot;BC Sans&quot;;font-size:12pt;\"><b><span lang=\"EN-US\">Risk Rating 4</span></b></span></p></td></tr><tr><td style=\"border-bottom-style:solid;border-color:windowtext;border-left-style:solid;border-right-style:solid;border-top-style:none;padding:0px 7px;vertical-align:top;width:151px;\" aria-label=\"Table cell\" width=\"151\"><p style=\"line-height: normal; margin: 0cm 0cm 0cm 0;\">I use all of the recommended practices</p></td><td style=\"border-bottom:1px solid windowtext;border-left-style:none;border-right:1px solid windowtext;border-top-style:none;padding:0px 7px;vertical-align:top;width:151px;\" aria-label=\"Table cell\" width=\"151\"><p style=\"line-height: normal; margin: 0cm 0cm 0cm 0;\">I use some of the recommended practices</p></td><td style=\"border-bottom:1px solid windowtext;border-left-style:none;border-right:1px solid windowtext;border-top-style:none;padding:0px 7px;vertical-align:top;width:151px;\" aria-label=\"Table cell\" width=\"151\"><p style=\"line-height: normal; margin: 0cm 0cm 0cm 0;\">I do not use any of the recommended practices</p></td><td style=\"border-bottom:1px solid windowtext;border-left-style:none;border-right:1px solid windowtext;border-top-style:none;padding:0px 7px;vertical-align:top;width:151px;\" aria-label=\"Table cell\" width=\"151\"><p style=\"margin: 0;\">Manure near water troughs can enter watercourses&nbsp;<br>&nbsp;</p><p style=\"margin: 0;\">OR&nbsp;<br>&nbsp;</p><p style=\"margin: 0;\">Livestock are not prevented from accessing streams, causing possible damage to habitat</p></td></tr><tr><td aria-label=\"Table cell\">&nbsp;</td><td aria-label=\"Table cell\">&nbsp;</td><td aria-label=\"Table cell\">&nbsp;</td><td aria-label=\"Table cell\">&nbsp;</td></tr></tbody></table><p style=\"margin: 0;\"><br>&nbsp;</p></div>",
