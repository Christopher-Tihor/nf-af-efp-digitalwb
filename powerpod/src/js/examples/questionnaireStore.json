                  "questions": [
                    {
                      "id": "8a427564-fc65-f011-bec2-002248afff4e",
                      "name": "253",
                      "label": "<div class=\"ck-content\" data-wrapper=\"true\" dir=\"ltr\" style=\"--ck-image-style-spacing: 1.5em; --ck-inline-image-style-spacing: calc(var(--ck-image-style-spacing) / 2); font-family: Segoe UI; font-size: 11pt;\"><div style=\"font-family:Segoe UI;font-size:11pt;\"><span><strong>253. Is </strong></span><a href=\"https://www2.gov.bc.ca/gov/content/industry/agriculture-seafood/agricultural-land-and-environment/soil-nutrients/nutrient-management/what-to-apply/soil-nutrient-testing\" target=\"_blank\" rel=\"noopener noreferrer\"><span><strong>soil testing</strong></span></a><span><strong> conducted annually for fields where nutrients are applied?</strong></span></div></div>",
                      "order": 253,
                      "complete": true,
                      "questionType": 100000001,
                      "textAboveQuestion": null,
                      "textBelowQuestion": "<div class=\"ck-content\" data-wrapper=\"true\" dir=\"ltr\" style=\"--ck-image-style-spacing: 1.5em; --ck-inline-image-style-spacing: calc(var(--ck-image-style-spacing) / 2); font-family: Segoe UI; font-size: 11pt;\"><div style=\"font-family:Segoe UI;font-size:11pt;\"><div style=\"font-family:Segoe UI;font-size:11pt;\">This includes testing for pH, macronutrients, micronutrients, EC, base saturation, and post-harvest nitrate.</div><div style=\"font-family:Segoe UI;font-size:11pt;\">&nbsp;</div><div style=\"font-family:Segoe UI;font-size:11pt;\"><u>Risk Ratings for this question:</u></div><div style=\"font-family:Segoe UI;font-size:11pt;\">&nbsp;</div><table class=\"table\" style=\"border-collapse:collapse;border-color:inherit;border-style:none;display:block;width:inherit;\" display=\"block\" width=\"inherit\" cellpadding=\"0\" cellspacing=\"0\" border=\"inherit\"><tbody><tr><td style=\"background-color:#00B050;border-color:windowtext;padding:0px 7px;vertical-align:top;width:151px;\" aria-label=\"Table cell\" width=\"151\"><p style=\"line-height: normal; margin: 0cm;\"><span style=\"color:black;font-family:&quot;BC Sans&quot;;font-size:12pt;\"><b><span lang=\"EN-US\">Risk Rating 1</span></b></span></p></td><td style=\"background-color:yellow;border-bottom-style:solid;border-color:windowtext;border-left-style:none;border-right-style:solid;border-top-style:solid;padding:0px 7px;vertical-align:top;width:151px;\" aria-label=\"Table cell\" width=\"151\"><p style=\"line-height: normal; margin: 0cm;\"><span style=\"color:black;font-family:&quot;BC Sans&quot;;font-size:12pt;\"><b><span lang=\"EN-US\">Risk Rating 2</span></b></span></p></td><td style=\"background-color:#FFC000;border-bottom-style:solid;border-color:windowtext;border-left-style:none;border-right-style:solid;border-top-style:solid;padding:0px 7px;vertical-align:top;width:151px;\" aria-label=\"Table cell\" width=\"151\"><p style=\"line-height: normal; margin: 0cm;\"><s