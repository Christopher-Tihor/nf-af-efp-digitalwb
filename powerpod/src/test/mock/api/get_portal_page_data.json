      "quartech_section5": "<span style=\"font-family:'BCSans','Noto Sans',Arial,Helvetica,sans-serif; font-size:16px; line-height:1.6;\"><p><strong>For more information:</strong></p><ul style=\"margin:8px 0 16px 22px; font-size:16px; line-height:1.6;\"><li><a href=\"https://www2.gov.bc.ca/gov/content/industry/agriculture-seafood/programs/environmental-farm-plan\" rel=\"noopener\">Environmental Farm Plan program page</a></li><li><a href=\"https://www2.gov.bc.ca/assets/gov/farming-natural-resources-and-industry/agriculture-and-seafood/agricultural-land-and-environment/environmental-farm-planning/efp-reference-guide/full_efp_reference_guide.pdf\" rel=\"noopener\">Full Reference Guide (PDF)</a></li><li><a href=\"https://iafbc.ca/environmental-farm-plan/\" rel=\"noopener\">IAF website</a></li></ul></span>",
